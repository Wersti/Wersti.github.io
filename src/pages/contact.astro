---
import Base from '../layouts/Base.astro';

const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xyzplbgr';

const field =
  'w-full rounded-lg border border-[var(--color-border-subtle)] bg-[var(--color-surface)] px-4 py-3 text-[var(--color-text-primary)] transition-colors duration-200 placeholder:text-[var(--color-text-muted)] focus:border-[var(--color-signal-500)]';
const labelClass = 'mb-2 block font-mono text-xs tracking-wider text-[var(--color-text-muted)] uppercase';
---

<Base
  title="Contact — Wersti"
  description="Get in touch with Wersti about collaboration, engineering work, or research enquiries."
  ogSlug="contact"
>
  <section class="shell py-24">
    <div class="grid gap-16 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="eyebrow mb-5">Say hello</p>
        <h1 class="text-h1 mb-8">Get in <em class="accent-italic">touch.</em></h1>
        <p class="text-lead mb-8 max-w-md text-[var(--color-text-secondary)]">
          Machine learning, numerics, quant research, or infrastructure work —
          if it involves probability or a hard systems problem, write. I read
          everything that arrives here.
        </p>
        <p class="font-mono text-sm text-[var(--color-text-muted)]">
          Or find me on{' '}
          <a href="https://github.com/Wersti" target="_blank" rel="noopener noreferrer" class="link">GitHub</a>.
        </p>
      </div>

      <div class="card p-8">
        <form id="contact-form" action={FORMSPREE_ENDPOINT} method="POST" novalidate>
          <div class="mb-6">
            <label for="name" class={labelClass}>Name</label>
            <input type="text" id="name" name="name" required autocomplete="name" class={field} placeholder="Your name" />
          </div>

          <div class="mb-6">
            <label for="email" class={labelClass}>Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" class={field} placeholder="you@example.com" />
          </div>

          <div class="mb-6">
            <label for="message" class={labelClass}>Message</label>
            <textarea id="message" name="message" rows="5" required class:list={[field, 'resize-y']} placeholder="What would you like to talk about?"></textarea>
          </div>

          <!-- Formspree honeypot (single underscore). -->
          <div hidden aria-hidden="true">
            <label for="_gotcha">Leave this field empty</label>
            <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="btn btn-primary w-full justify-center">
            <span data-submit-label>Send message</span>
          </button>

          <p
            data-form-feedback
            role="status"
            aria-live="polite"
            tabindex="-1"
            class="mt-4 text-sm empty:mt-0 focus:outline-none"
          >
          </p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  // Re-bind on every page-load: with the ClientRouter, revisiting this page is
  // a DOM swap and the module does not run again.
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const feedback = form.querySelector<HTMLElement>('[data-form-feedback]');
    const label = form.querySelector<HTMLElement>('[data-submit-label]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    function setFeedback(message: string, ok: boolean) {
      if (!feedback) return;
      feedback.textContent = message;
      feedback.style.color = ok ? 'var(--color-signal-300)' : 'var(--color-ember-400)';
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const originalLabel = label?.textContent ?? 'Send message';
      if (button) button.disabled = true;
      if (label) label.textContent = 'Sending…';
      setFeedback('', true);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.reset();
          setFeedback('Thanks — your message is on its way. I’ll reply soon.', true);
          feedback?.focus();
        } else {
          const data = await response.json().catch(() => null);
          const detail = Array.isArray(data?.errors)
            ? data.errors.map((e: { message: string }) => e.message).join(', ')
            : 'Something went wrong sending your message. Please try again.';
          setFeedback(detail, false);
        }
      } catch {
        setFeedback('Could not reach the server. Check your connection and try again.', false);
      } finally {
        if (button) button.disabled = false;
        if (label) label.textContent = originalLabel;
      }
    });
  });
</script>
