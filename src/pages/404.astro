---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Wersti" description="That page does not exist.">
  <section class="shell flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="eyebrow mb-6">Error 404</p>
    <h1 class="text-display mb-8">Not found</h1>
    <p class="text-lead mb-10 max-w-md text-[var(--color-text-secondary)]">
      That page doesn’t exist — it may have been moved or renamed.
    </p>
    <a href="/" class="btn btn-primary">
      Back home
      <span aria-hidden="true">→</span>
    </a>
  </section>
</Base>
