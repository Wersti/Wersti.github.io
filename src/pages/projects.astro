---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import { getProjects } from '../lib/github';

const { ok, projects } = await getProjects();
---

<Base
  title="Projects — Wersti"
  description="Projects by Wersti across wireless communications, numerical methods for PDEs, and cryptography."
  ogSlug="projects"
>
  <section class="shell pt-24 pb-12">
    <p class="eyebrow mb-5">Selected work</p>
    <h1 class="text-h1 mb-8 max-w-4xl">
      Things I’ve built, <em class="accent-italic">mostly to understand them.</em>
    </h1>
    <p class="text-lead max-w-2xl text-[var(--color-text-secondary)]">
      Research code and experiments, from a massive-MIMO thesis to PDE solvers. Pulled from GitHub
      at build time.
    </p>
  </section>

  <section class="shell">
    {
      ok && projects.length > 0 ? (
        <ProjectList projects={projects} />
      ) : (
        <div class="border-y border-[var(--color-border-subtle)] py-12">
          <p class="mb-6 text-[var(--color-text-secondary)]">
            {ok ? 'No public projects yet.' : 'The project list could not be loaded when this page was built.'}
          </p>
          <a href="https://github.com/Wersti" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            Browse on GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      )
    }

    <p class="mt-12 font-mono text-sm text-[var(--color-text-muted)]">
      Everything else lives on{' '}
      <a href="https://github.com/Wersti" target="_blank" rel="noopener noreferrer" class="link">GitHub</a>.
    </p>
  </section>
</Base>
