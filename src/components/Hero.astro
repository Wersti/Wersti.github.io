---
import { Image } from 'astro:assets';
import avatar from '../assets/wersti.png';
---

<!-- No overflow-hidden: it would make this a scroll container, and the
     view()-timeline parallax below would then never progress. -->
<section class="relative">
  <!-- Back layer: glow (also the no-WebGL fallback) plus the attractor canvas.
       Parallax and departure sit on separate elements so their animations
       don't override each other. -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
    style="background: radial-gradient(ellipse 70% 55% at 68% 42%, color-mix(in oklab, var(--color-signal-700) 18%, transparent), transparent 70%);"
  >
    <div class="parallax absolute inset-y-0 right-0 w-full lg:w-[44%]" style="--depth: 0.1;">
      <div class="hero-depart h-full w-full">
        <canvas id="attractor" class="h-full w-full opacity-0 transition-opacity duration-1000"></canvas>
      </div>
    </div>
  </div>

  <div class="shell grid min-h-[min(calc(100svh-4rem),52rem)] items-center gap-12 py-20 lg:grid-cols-[1fr_auto]">
    <!-- Front layer: negative depth, so the copy reads as nearest. -->
    <div class="parallax" style="--depth: -0.06;">
      <div class="mb-8 flex items-center gap-4">
        <Image
          src={avatar}
          alt="Portrait of Wersti"
          width={48}
          height={48}
          densities={[1, 2]}
          format="webp"
          quality={82}
          loading="eager"
          class="size-12 rounded-full border border-[var(--color-border-strong)] object-cover"
        />
        <p class="eyebrow">Mathematician · Telematics Engineer</p>
      </div>

      <h1 class="text-display mb-8 max-w-[13ch]">
        Probability, learning, and systems <em class="accent-italic">that hold up.</em>
      </h1>

      <p class="text-lead mb-10 max-w-xl text-[var(--color-text-secondary)]">
        I work across machine learning, stochastic modelling, and security engineering —
        from GPU-accelerated numerics to the cloud infrastructure they run on.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="/projects/" class="btn btn-primary">
          See my work <span aria-hidden="true">→</span>
        </a>
        <a href="/contact/" class="btn btn-ghost">Get in touch</a>
      </div>
    </div>

    <!-- Keeps the right-hand column clear for the canvas behind. -->
    <div class="hidden lg:block lg:w-[24rem]" aria-hidden="true"></div>
  </div>
</section>

<script>
  function hasWebGL() {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  // Bundled scripts run once per full load; with the ClientRouter, returning to
  // the home page is a swap, not a load. astro:page-load fires for both.
  document.addEventListener('astro:page-load', () => {
    const canvas = document.getElementById('attractor') as HTMLCanvasElement | null;
    if (!canvas) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(min-width: 1024px)').matches || !hasWebGL()) return;

    let destroy: (() => void) | undefined;

    // Load the WebGL module only once the hero is on screen.
    const io = new IntersectionObserver(async ([entry]) => {
      if (!entry.isIntersecting) return;
      io.disconnect();
      try {
        const { initAttractor } = await import('../scripts/attractor');
        destroy = initAttractor(canvas);
        canvas.classList.remove('opacity-0');
      } catch (err) {
        console.warn('Attractor failed to initialise:', err);
      }
    });
    io.observe(canvas.parentElement ?? canvas);

    document.addEventListener(
      'astro:before-swap',
      () => {
        destroy?.();
        io.disconnect();
      },
      { once: true }
    );
  });
</script>
