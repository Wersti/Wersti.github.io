---
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/contact/', label: 'Contact' },
];

// Normalise so "/projects" and "/projects/" both match.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header
  class="sticky top-0 z-50 border-b border-[var(--color-border-subtle)] bg-[color-mix(in_oklab,var(--color-surface)_78%,transparent)] backdrop-blur-xl"
>
  <nav class="shell flex items-center justify-between py-4" aria-label="Main">
    <a
      href="/"
      transition:name="wordmark"
      class="font-[family-name:var(--font-serif)] text-2xl text-[var(--color-text-primary)] no-underline"
    >
      Wersti<span class="text-[var(--color-text-accent)]">.</span>
    </a>

    <ul class="flex list-none items-center gap-1">
      {
        links.map((link) => {
          const linkPath = link.href.replace(/\/+$/, '') || '/';
          const isActive = path === linkPath;
          return (
            <li>
              <a
                href={link.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'relative rounded-full px-3.5 py-2 text-sm font-medium no-underline transition-colors duration-200',
                  isActive
                    ? 'text-[var(--color-text-primary)]'
                    : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]',
                ]}
              >
                {/* Separate element with a shared transition name, so the pill
                    slides between links without morphing the label text. */}
                {isActive && (
                  <span
                    transition:name="nav-pill"
                    class="absolute inset-0 -z-10 rounded-full bg-[var(--color-surface-overlay)]"
                    aria-hidden="true"
                  />
                )}
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
